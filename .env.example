# Mẫu tệp môi trường trên máy. Chép thành .env rồi điền giá trị; .env không đưa lên kho.
# Sinh khóa ngẫu nhiên 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# PostgreSQL của docker-compose (cổng 5442 trên máy)
POSTGRES_PASSWORD=
PGHOST=127.0.0.1
PGPORT=5442
POSTGRES_USER=postgres

# Chuỗi kết nối bằng vai trò riêng của chợ; `pnpm cai-dat-tren-may` tự ghi dòng này
DATABASE_URL=

# Khóa mã hóa khóa TOTP của tài khoản quản trị (bắt buộc) và tệp giấy tờ, bản ghi buổi học (trống thì chưa nhận tệp)
MARKET_SECRETS_KEY=
MARKET_FILES_KEY=

# Tên miền (kèm cổng) của ứng dụng chợ, dùng cho địa chỉ trả về sau đăng nhập bằng nhà cung cấp định danh
MARKET_HOST=localhost:5300
PORT=3300

# Phòng video: trống là tắt; mock chỉ dùng trên máy và kiểm thử; livekit cần LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET
VIDEO_PROVIDER=mock

# Kho tệp tương thích S3 (SeaweedFS của docker-compose, cổng 8343)
S3_ENDPOINT=http://127.0.0.1:8343
S3_REGION=us-east-1
S3_BUCKET=cho-gia-su
S3_ACCESS_KEY_ID=phat_trien
S3_SECRET_ACCESS_KEY=phat_trien

# Nhà cung cấp định danh OIDC cho xác minh gia sư, đăng nhập (không bắt buộc), dạng JSON như README mục "Định danh"
MARKET_IDENTITY_PROVIDERS=
