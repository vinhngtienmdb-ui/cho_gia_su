{
  "name": "cho-gia-su",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "database:migrate": "pnpm --filter @cho-gia-su/database migrate",
    "environment:start": "docker compose up -d",
    "environment:stop": "docker compose down",
    "dev": "node scripts/chay-tren-may.mjs",
    "test:e2e": "pnpm --filter @cho-gia-su/tests e2e",
    "cai-dat-tren-may": "pnpm --filter @cho-gia-su/database cai-dat-tren-may"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.5.0": "^2.5.0",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0"
    }
  }
}
